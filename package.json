{
  "name": "siebel-escript",
  "displayName": "Siebel eScript (ST)",
  "description": "Siebel eScript language support with typed with-scopes, IntelliSense, documentation and diagnostics.",
  "version": "1.0.0",
  "publisher": "titansystems-de",
  "repository": {
    "type": "git",
    "url": "https://github.com/TitanSystems-DE/TitanSystems.Siebel.VSCode.LanguageExtension.git"
  },
  "bugs": {
    "url": "https://github.com/TitanSystems-DE/TitanSystems.Siebel.VSCode.LanguageExtension/issues"
  },
  "icon": "icons/extension-icon.png",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "Siebel",
    "eScript",
    "ST",
    "with"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:escript"
  ],
  "main": "./src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "languages": [
      {
        "id": "escript",
        "aliases": [
          "Siebel eScript",
          "escript"
        ],
        "extensions": [
          ".escript"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/escript-file.png",
          "dark": "./icons/escript-file.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "escript",
        "scopeName": "source.escript",
        "path": "./syntaxes/escript.tmLanguage.json"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "referenceParameter",
        "description": "A parameter passed by reference in Siebel eScript"
      }
    ],
    "commands": [
      {
        "command": "escript.restartLanguageService",
        "title": "Siebel eScript: Restart Language Service"
      }
    ],
    "configuration": {
      "title": "Siebel eScript",
      "properties": {
        "escript.strict": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable strict Siebel eScript type checks. This does not enable JavaScript runtime strict mode."
        },
        "escript.maxProblems": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 1000,
          "scope": "resource",
          "description": "Maximum number of diagnostics per file."
        },
        "escript.metadataProvider": {
          "type": "string",
          "enum": [
            "none",
            "endoit",
            "native"
          ],
          "enumDescriptions": [
            "Do not use Siebel Repository metadata.",
            "Read metadata generated by the Endoit Siebel Script And Web Template Editor in this workspace.",
            "Reserved for a future direct TitanSystems Siebel connection; currently supplies no metadata."
          ],
          "default": "none",
          "scope": "resource",
          "description": "Selects the optional source for repository-aware Business Object, Business Component, and field completion."
        }
      }
    },
    "configurationDefaults": {
      "[escript]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        },
        "editor.suggestOnTriggerCharacters": true,
        "editor.parameterHints.enabled": true,
        "editor.semanticHighlighting.enabled": true,
        "editor.semanticTokenColorCustomizations": {
          "rules": {
            "variable.referenceParameter": {
              "underline": true
            }
          }
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true
  }
}
